SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0010011> <http://purl.obolibrary.org/obo/UBERON_0010009>)
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0010011> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0000454>))
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0010011> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002131> <http://purl.obolibrary.org/obo/UBERON_0001891>))
